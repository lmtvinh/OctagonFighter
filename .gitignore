# =============================================================================
# Octagon Fighter - Unity 6 .gitignore
# Based on Unity's official templates, extended for Unity 6 / URP / Rider / VS.
# Track project assets, packages, and settings. Ignore generated tooling output.
# =============================================================================

# --- Unity generated directories -------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ocal[Cc]ache/
/[Uu]nityGenerated/
/[Ee]xported[Oo]bj/

# --- IDE / code editor ------------------------------------------------------
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.opendb
*.vsconfig
*.DotSettings.user

# Unity auto-generated IDE metadata (keep the asset .meta files themselves)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- Unity generated files --------------------------------------------------
*.log
*.assemblyReferenceTypeCache
*.shadercompiler
*.burstconfig
*.burstdebug*
sysinfo.txt
crashlytics-build.properties

# --- Crash / test / profiling output ---------------------------------------
TestResults/
*.testRunnerSettings.json

# --- Addressables -----------------------------------------------------------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# --- Build artifacts --------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app

# --- IL2CPP / Gradle --------------------------------------------------------
il2cppOutput/
gradle/

# --- Asset Store tooling ----------------------------------------------------
/[Aa]ssets/AssetStoreTools*

# --- Cloud / version control integrations ----------------------------------
*[Cc]loud[Aa]ttributes
PlasticSCM/

# --- OS generated -----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Packages ---------------------------------------------------------------
# Packages/manifest.json, Packages/packages-lock.json, and embedded packages
# under Packages/ are tracked. Only transient package archives are ignored.
/[Pp]ackages/*.tgz
/[Pp]ackages/*.tar.gz
